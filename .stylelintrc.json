{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": [
          "Outfit",
          "Manrope",
          "Segoe UI",
          "Palatino",
          "Georgia",
          "Helvetica",
          "Arial"
        ]
      }
    ]
  }
}
